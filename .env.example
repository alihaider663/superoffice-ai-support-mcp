# ============================================================================
# SuperOffice AI Support MCP Platform — Environment Configuration Template
# ============================================================================
# Copy this file to .env and configure values for your environment.
# Never commit real credentials or production endpoints to version control.
# ============================================================================

# ============================================================================
# 1. MCP Gateway & Security Settings (Layer 2)
# ============================================================================
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_REQUEST_TIMEOUT_SECONDS=30
GATEWAY_MAX_CONCURRENT_REQUESTS=100

# Gateway Downstream Service Routing
GATEWAY_SUPEROFFICE_MCP_URL=http://127.0.0.1:8001
GATEWAY_DIAGNOSTICS_MCP_URL=http://127.0.0.1:8002
GATEWAY_KNOWLEDGE_MCP_URL=http://127.0.0.1:8003
GATEWAY_INFRASTRUCTURE_MCP_URL=http://127.0.0.1:8004
GATEWAY_INVESTIGATION_MCP_URL=http://127.0.0.1:8005

# Security, Authentication & PII Masking
SECURITY_ENABLE_AUTH=true
SECURITY_JWT_SECRET_KEY=your-local-development-jwt-secret-min-32-chars
SECURITY_JWT_ALGORITHM=HS256
SECURITY_JWT_AUDIENCE=superoffice-ai-platform
SECURITY_JWT_ISSUER=superoffice-platform-gateway
SECURITY_TOKEN_EXPIRATION_SECONDS=3600
SECURITY_ENABLE_PII_REDACTION=true
SECURITY_ALLOW_ATTACHMENT_DOWNLOADS=false

# ============================================================================
# 2. SuperOffice MCP Server & REST API Settings (Layer 1 & Layer 5)
# ============================================================================
SUPEROFFICE_PORT=8001
SUPEROFFICE_HOST=0.0.0.0

# Active Primary SuperOffice API Endpoint
SUPEROFFICE_API_URL=https://superoffice.example.internal/SuperOffice

# Active Application Server Nodes for Cluster Health Monitoring
# Note: Provide comma-separated URLs for all IIS nodes that serve this specific tenant.
# Nodes belonging to a different tenant/database must NOT be listed here.
SUPEROFFICE_APP_SERVERS=https://superoffice-node1.example.internal/SuperOffice

SUPEROFFICE_USERNAME=admin
SUPEROFFICE_PASSWORD=your-superoffice-api-password
SUPEROFFICE_TIMEOUT_SECONDS=30

# Local Development Only: Set true if connecting to local test server with self-signed TLS cert.
# Production default MUST be false.
SUPEROFFICE_ALLOW_SELF_SIGNED_CERT=false

# Codebase Mirror & Sync Settings
SUPEROFFICE_CODEBASE_LOCAL_PATH=F:\CodeBase_SuperOffice
SUPEROFFICE_CRMSCRIPT_SYNC_ENDPOINT=scripts/customer.fcgi?action=safeParse&includeId=
SUPEROFFICE_SYNC_DEFAULT_MODE=http
SUPEROFFICE_SYNC_BATCH_SIZE=100

# Direct MSSQL Connection (for codebase sync and schema discovery)
SUPEROFFICE_MSSQL_HOST=localhost
SUPEROFFICE_MSSQL_PORT=1433
SUPEROFFICE_MSSQL_DATABASE=SuperOffice
SUPEROFFICE_MSSQL_USER=so_readonly_user
SUPEROFFICE_MSSQL_PASSWORD=your-secure-db-password
SUPEROFFICE_MSSQL_TRUST_SERVER_CERTIFICATE=false

# ============================================================================
# 3. Diagnostics MCP Server & MSSQL Telemetry (Layer 1 & Layer 5)
# ============================================================================
DIAGNOSTICS_PORT=8002
DIAGNOSTICS_HOST=0.0.0.0
DIAGNOSTICS_MSSQL_HOST=localhost
DIAGNOSTICS_MSSQL_PORT=1433
DIAGNOSTICS_MSSQL_DATABASE=SuperOffice
DIAGNOSTICS_MSSQL_USER=so_readonly_user
DIAGNOSTICS_MSSQL_PASSWORD=your-secure-db-password
DIAGNOSTICS_MSSQL_TRUST_SERVER_CERTIFICATE=false

# Performance & Query Bound Constraints (Canonical: 5s timeout, 50-row max)
DIAGNOSTICS_MSSQL_LOGIN_TIMEOUT_SECONDS=5
DIAGNOSTICS_MSSQL_QUERY_TIMEOUT_SECONDS=5
DIAGNOSTICS_MSSQL_MAX_ROWS=50
DIAGNOSTICS_MSSQL_ISOLATION_LEVEL=READ COMMITTED
DIAGNOSTICS_MSSQL_POOL_SIZE=5
DIAGNOSTICS_MSSQL_MAX_OVERFLOW=2
DIAGNOSTICS_MSSQL_POOL_RECYCLE_SECONDS=1800
DIAGNOSTICS_MSSQL_POOL_PRE_PING=true

# Application Log Settings (SuperOffice warning logs from dbo.config)
DIAGNOSTICS_APPLICATION_LOG_ENABLED=false
# DIAGNOSTICS_APPLICATION_LOG_PATH_OVERRIDE=
DIAGNOSTICS_APPLICATION_MAX_FILES=3
DIAGNOSTICS_APPLICATION_MAX_SCAN_BYTES=10485760
# DIAGNOSTICS_APPLICATION_LOG_TIMEZONE=

# IIS / W3C Log Reader Settings
DIAGNOSTICS_IIS_LOG_ENABLED=false
# DIAGNOSTICS_IIS_LOG_PATH=C:\inetpub\logs\LogFiles\W3SVC1
DIAGNOSTICS_IIS_MAX_FILES=3
DIAGNOSTICS_IIS_MAX_SCAN_BYTES=33554432

# ============================================================================
# 4. Knowledge MCP Server & pgvector Settings (Layer 1 & Layer 5)
# ============================================================================
KNOWLEDGE_PORT=8003
KNOWLEDGE_HOST=127.0.0.1

# Decomposed PostgreSQL Connection Parameters
KNOWLEDGE_DATABASE_HOST=localhost
KNOWLEDGE_DATABASE_PORT=5432
KNOWLEDGE_DATABASE_NAME=superoffice_ai_knowledge
KNOWLEDGE_DATABASE_USER=postgres
KNOWLEDGE_DATABASE_PASSWORD=your-postgres-password
KNOWLEDGE_DATABASE_SCHEMA=knowledge

# Legacy Fallback URL (Optional, auto-generated from above parameters if omitted)
# KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/superoffice_ai_knowledge

# PostgreSQL Connection Pool Settings
KNOWLEDGE_POOL_SIZE=5
KNOWLEDGE_MAX_OVERFLOW=10
KNOWLEDGE_POOL_RECYCLE_SECONDS=1800
KNOWLEDGE_POOL_PRE_PING=true
KNOWLEDGE_TIMEOUT_SECONDS=10
KNOWLEDGE_MAX_SEARCH_RESULTS=5
KNOWLEDGE_MAX_SEARCH_RESULTS_CEILING=50

# FastEmbed Local Vector Embeddings
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KNOWLEDGE_EMBEDDING_DIMENSION=384
FASTEMBED_CACHE_PATH=./.fastembed_cache
KNOWLEDGE_ARTIFACT_STORE_PATH=./data/knowledge/approved

# ============================================================================
# 5. Investigation MCP Server Settings (Layer 1 & Layer 3)
# ============================================================================
INVESTIGATION_PORT=8005
INVESTIGATION_HOST=0.0.0.0
INVESTIGATION_TIMEOUT_SECONDS=30

# ============================================================================
# 6. Global Observability & Logging Settings
# ============================================================================
LOGGING_LEVEL=INFO
LOGGING_FORMAT=json
LOGGING_ENABLE_CONSOLE=true
LOGGING_ENABLE_CORRELATION_ID=true
