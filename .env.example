# ============================================================================
# SuperOffice CRM REST API Settings
# ============================================================================
SUPEROFFICE_API_URL=https://superoffice.example.internal/SuperOffice
SUPEROFFICE_USERNAME=admin
SUPEROFFICE_PASSWORD=your-secure-password
SUPEROFFICE_TIMEOUT_SECONDS=30
SUPEROFFICE_ALLOW_SELF_SIGNED_CERT=false

# ============================================================================
# Diagnostics MCP Server & MSSQL Settings
# ============================================================================
DIAGNOSTICS_PORT=8002
DIAGNOSTICS_MSSQL_HOST=localhost
DIAGNOSTICS_MSSQL_PORT=1433
DIAGNOSTICS_MSSQL_DATABASE=SuperOffice
DIAGNOSTICS_MSSQL_USER=so_readonly_user
DIAGNOSTICS_MSSQL_PASSWORD=your-secure-db-password

# Canonical Architecture Decisions (2A-D01, 2A-D02, 2A-D09)
DIAGNOSTICS_MSSQL_QUERY_TIMEOUT_SECONDS=5
DIAGNOSTICS_MSSQL_MAX_ROWS=50
DIAGNOSTICS_MSSQL_ISOLATION_LEVEL=SNAPSHOT

# Operational Configuration Defaults (Externally Configurable)
DIAGNOSTICS_MSSQL_LOGIN_TIMEOUT_SECONDS=5
DIAGNOSTICS_MSSQL_POOL_SIZE=5
DIAGNOSTICS_MSSQL_MAX_OVERFLOW=2
DIAGNOSTICS_MSSQL_POOL_RECYCLE_SECONDS=1800
DIAGNOSTICS_MSSQL_POOL_PRE_PING=true
# Local Development Only: Trust SQL Server TLS certificate without CA verification
# Production default MUST be false; preferred production configuration is trusted CA validation.
DIAGNOSTICS_MSSQL_TRUST_SERVER_CERTIFICATE=false

# ============================================================================
# Diagnostics IIS / W3C Log Reader Settings
# ============================================================================
DIAGNOSTICS_IIS_LOG_ENABLED=false
# Set this to the exact W3C directory for the SuperOffice IIS site,
# for example C:\inetpub\logs\LogFiles\W3SVC<actual-site-id>.
# Do NOT set to parent C:\inetpub\logs\LogFiles or guess site IDs.
DIAGNOSTICS_IIS_LOG_PATH=C:\inetpub\logs\LogFiles\W3SVC_EXAMPLE

# ============================================================================
# Diagnostics Application / Warning Log Settings (Gate 7A.4B1)
# ============================================================================
DIAGNOSTICS_APPLICATION_LOG_ENABLED=true

# Normal runtime location is resolved from:
# SELECT TOP (1) [warning] FROM [dbo].[config]
#
# Expected semantic value:
# <directory>\<filename-prefix>
#
# Example only:
# D:\SuperOffice\SO_CS\log\warning
#
# Leave empty to use dbo.config.warning.
# Set only for trusted local/testing/deployment override.
DIAGNOSTICS_APPLICATION_LOG_PATH_OVERRIDE=

DIAGNOSTICS_APPLICATION_MAX_FILES=3
