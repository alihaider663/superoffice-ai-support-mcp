# ============================================================================
# SuperOffice AI Support MCP Platform — Local Environment Template
# ============================================================================
# Copy this file to .env and configure values for your local development environment.
# Never commit real credentials or production endpoints to version control.
# ============================================================================

# ============================================================================
# 1. MCP Gateway & Security Settings (Layer 2)
# ============================================================================
GATEWAY_PORT=8000
GATEWAY_HOST=127.0.0.1

# Local Development Only: Symmetric HS256 secret key.
# Production requires asymmetric RS256 signing or JWKS validation.
SECURITY_JWT_SECRET_KEY=your-local-development-jwt-secret-min-32-chars
SECURITY_JWT_ALGORITHM=HS256
SECURITY_JWT_AUDIENCE=superoffice-ai-platform
SECURITY_JWT_ISSUER=superoffice-platform-gateway

# ============================================================================
# 2. SuperOffice MCP Server & REST API Settings (Layer 1 & Layer 5)
# ============================================================================
SUPEROFFICE_PORT=8001
SUPEROFFICE_API_URL=https://superoffice.example.internal/SuperOffice
SUPEROFFICE_USERNAME=admin
SUPEROFFICE_PASSWORD=your-secure-password
SUPEROFFICE_TIMEOUT_SECONDS=30

# Local Development Only: Set true if connecting to local test server with self-signed TLS certificate.
# Production default MUST be false.
SUPEROFFICE_ALLOW_SELF_SIGNED_CERT=false

# ============================================================================
# 3. Diagnostics MCP Server & MSSQL Settings (Layer 1 & Layer 5)
# ============================================================================
DIAGNOSTICS_PORT=8002
DIAGNOSTICS_MSSQL_HOST=localhost
DIAGNOSTICS_MSSQL_PORT=1433
DIAGNOSTICS_MSSQL_DATABASE=SuperOffice
DIAGNOSTICS_MSSQL_USER=so_readonly_user
DIAGNOSTICS_MSSQL_PASSWORD=your-secure-db-password

# Canonical Architecture Decisions (2A-D01, 2A-D02, 2A-D09)
DIAGNOSTICS_MSSQL_QUERY_TIMEOUT_SECONDS=5
DIAGNOSTICS_MSSQL_MAX_ROWS=50
DIAGNOSTICS_MSSQL_ISOLATION_LEVEL=SNAPSHOT

# Operational Configuration Defaults
DIAGNOSTICS_MSSQL_LOGIN_TIMEOUT_SECONDS=5
DIAGNOSTICS_MSSQL_POOL_SIZE=5
DIAGNOSTICS_MSSQL_MAX_OVERFLOW=2
DIAGNOSTICS_MSSQL_POOL_RECYCLE_SECONDS=1800
DIAGNOSTICS_MSSQL_POOL_PRE_PING=true

# Local Development Only: Trust SQL Server TLS certificate without CA verification
# Production default MUST be false; preferred production configuration is trusted CA validation.
DIAGNOSTICS_MSSQL_TRUST_SERVER_CERTIFICATE=false

# ============================================================================
# 4. Diagnostics IIS / W3C Log Reader Settings
# ============================================================================
DIAGNOSTICS_IIS_LOG_ENABLED=false
# Set this to the exact W3C directory for the SuperOffice IIS site,
# for example C:\inetpub\logs\LogFiles\W3SVC<actual-site-id>.
# Do NOT set to parent C:\inetpub\logs\LogFiles or guess site IDs.
DIAGNOSTICS_IIS_LOG_PATH=C:\inetpub\logs\LogFiles\W3SVC_EXAMPLE

# ============================================================================
# 5. Diagnostics Application / Warning Log Settings
# ============================================================================
DIAGNOSTICS_APPLICATION_LOG_ENABLED=true

# Normal runtime location is resolved from:
# SELECT TOP (1) [warning] FROM [dbo].[config]
# Leave empty to use dbo.config.warning. Set only for trusted local/testing override.
DIAGNOSTICS_APPLICATION_LOG_PATH_OVERRIDE=
DIAGNOSTICS_APPLICATION_MAX_FILES=3
DIAGNOSTICS_APPLICATION_LOG_TIMEZONE=

# ============================================================================
# 6. Knowledge MCP Server & pgvector Settings (Layer 1 & Layer 5)
# ============================================================================
KNOWLEDGE_PORT=8003
KNOWLEDGE_HOST=127.0.0.1

# Local Development Only: Local PostgreSQL database URL with pgvector extension.
KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/superoffice_ai_knowledge
KNOWLEDGE_SCHEMA=knowledge

# FastEmbed Local Embedding Settings
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KNOWLEDGE_EMBEDDING_DIMENSION=384
FASTEMBED_CACHE_PATH=./.fastembed_cache

# Local Immutable Artifact Store Path
KNOWLEDGE_ARTIFACT_STORE_PATH=./data/knowledge/approved

# ============================================================================
# 7. Investigation MCP Server Settings (Layer 1 & Layer 3)
# ============================================================================
INVESTIGATION_PORT=8005
INVESTIGATION_HOST=127.0.0.1
INVESTIGATION_TIMEOUT_SECONDS=60
